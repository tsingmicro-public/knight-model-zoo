{
    "chip": "TX5336AV200",
    "quant": {
        "model": "/data/model_convert/yoloxs/yolox_s.onnx",
        "infer-func": "infer_common",
        "bit-width": 8,
        "quant-mode": "mse",
        "batch-size": 1,
        "run-mode": "quant",
        "iteration": 10,
        "output-dequant": true,
        "dump": true,
        "save-dir": "/data/model_convert/yoloxs/output/quant",
        "opset-version":14,
        "log-level": 3,
        "user-defined-script": "/opt/Quantize/onnx_examples/infer_common.py",
        "quantize-input-dtype": "uint8",
        "input-configs": [
            {
                "input_name": "onnx::Slice_0",
                "quant_data_format": "Bin",
                "data_dir": "/data/model_convert/yoloxs/quant_data",
                "mean": [
                    0,
                    0,
                    0
                ],
                "std": [
                    255.0,
                    255.0,
                    255.0
                ]
            }
        ]
    },
    "compile": {
        "onnx":"/data/model_convert/yoloxs/output/yolox_s_quantize.onnx",
        "log-level":3,
        "save-dir": "/data/model_convert/yoloxs/output/compile"
    },
    "profiling": {
        "model":"/data/model_convert/yoloxs/output/compile/yolox_s_quantize_r.tsmodel",
        "save-dir": "/data/model_convert/yoloxs/output/profiling"
    }
}